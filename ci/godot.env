# The pinned Godot (CLAUDE.md: Godot 4.7.2; an upgrade is its own branch). One source for every consumer:
# scripts/godot_check.py refuses any other version, ci/install_godot.sh installs these builds on CI runners, and
# ci/godot-golden/Dockerfile installs the Linux build in the golden image. The SHA-256 digests were computed from the
# official release assets, whose SHA-512 matched the release's SHA512-SUMS.txt (2026-11-19).
GODOT_VERSION=4.7.2.stable.official.ed1daf0bf
GODOT_RELEASE_URL=https://github.com/godotengine/godot/releases/download/4.7.2-stable
GODOT_LINUX_X86_64_ZIP=Godot_v4.7.2-stable_linux.x86_64.zip
GODOT_LINUX_X86_64_SHA256=cadd3204e728a35d3f13adb7fd0d7902636b79f6b95c40c265eb73b6c35329e4
GODOT_LINUX_X86_64_BIN=Godot_v4.7.2-stable_linux.x86_64
GODOT_MACOS_UNIVERSAL_ZIP=Godot_v4.7.2-stable_macos.universal.zip
GODOT_MACOS_UNIVERSAL_SHA256=c58a24e31d720be9d62f60cb5627c4e695fb72f21b0cfe1bc9ccaa9a3b3ba63e
GODOT_MACOS_UNIVERSAL_BIN=Godot.app/Contents/MacOS/Godot
